# Copy this file to `.env` and fill it in. `.env` is git-ignored, so never commit real keys.

# LLM provider: "nvidia" (NVIDIA NIM) or "gemini" (Google AI Studio).
LLM_PROVIDER=nvidia

# API key for the chosen provider.
#   NVIDIA NIM:       https://build.nvidia.com  (key starts with "nvapi-")
#   Google AI Studio: https://aistudio.google.com/apikey
LLM_API_KEY=

# Optional overrides (defaults in app/config.py).
# Tested on NIM: nvidia/nemotron-3-super-120b-a12b (default; most accurate, ~5-15s per call)
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# LLM_BASE_URL=
# LLM_TIMEOUT_SECONDS=30

# Extra JSON merged into every request. Faster alternative model on NIM, with thinking disabled:
# LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
