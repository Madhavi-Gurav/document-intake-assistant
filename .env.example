# Copy this file to `.env` and fill it in. `.env` is git-ignored, so never commit real keys.

# LLM provider: "gemini" (Google AI Studio) or "nvidia" (NVIDIA NIM).
LLM_PROVIDER=gemini

# API key for the chosen provider.
#   Google AI Studio: https://aistudio.google.com/apikey
#   NVIDIA NIM:       https://build.nvidia.com  (key starts with "nvapi-")
LLM_API_KEY=

# Optional overrides. Each provider has sensible defaults (see app/config.py).
# LLM_MODEL=gemini-2.5-flash
# LLM_MODEL=meta/llama-3.3-70b-instruct
# LLM_BASE_URL=
# LLM_TIMEOUT_SECONDS=60
